{
  "name": "kicadtools",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "ARNAUDIN Remy",
  "type": "commonjs",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "electron-builder",
    "postinstall": "node ./script/install-electron.js"
  },
  "homepage": ".",
  "build": {
    "asar": true,
    "directories": {
      "output": "build"
    },
    "extraResources": [],
    "extraMetadata": {
      "main": "out/main/index.js"
    },
    "win": {
      "target": "nsis",
      "icon": "src/renderer/favicon.png",
      "artifactName": "${name}-Setup-${version}.${ext}",
      "files": [
        "*.env",
        "**/out/**/*",
        "!webpack*",
        "!src/*",
        "!*.log",
        "!dev-app-update.yml",
        "!.vscode/*",
        "!*.vite.config.*",
        "!*.config.*",
        "!.github/*",
        "!*.md",
        "!public/*"
      ]
    },
    "publish": {
      "provider": "github",
      "repo": "Kicad_Tools",
      "owner": "remyar"
    }
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "dependencies": {
    "@electron/remote": "^2.1.4",
    "@emotion/styled": "^11.14.1",
    "@mona-health/react-input-mask": "^3.0.3",
    "@mui/icons-material": "^9.6.0",
    "@mui/material": "^9.6.0",
    "@react-input/mask": "^2.0.4",
    "@remyar/react-navigation": "^2.0.9",
    "@remyar/react-snackbar": "^1.0.4",
    "@remyar/react-store": "^2.0.9",
    "dotenv": "^18.0.10",
    "electron-fetch": "^1.9.1",
    "electron-log": "^5.4.4",
    "electron-store": "^12.0.0",
    "electron-updater": "^6.8.11",
    "formik": "^2.4.9",
    "intel-hex": "^0.2.0",
    "jwt-decode": "^4.0.0",
    "koffi": "^3.3.8",
    "lodash": "^4.18.1",
    "modbus-serial": "^8.0.25",
    "mssql": "^12.8.1",
    "ni-visa": "^0.0.2",
    "node-html-parser": "^9.0.7",
    "octokit": "^5.0.5",
    "public-ip": "^8.0.0",
    "react-datepicker": "^9.1.0",
    "react-intl": "12.2.1",
    "semver": "^7.8.6",
    "serialport": "^13.0.0",
    "systeminformation": "^5.33.26",
    "unzipper": "^0.12.5",
    "usb": "^3.3.0",
    "yauzl": "^3.4.0",
    "yup": "^1.7.1"
  },
  "overrides": {
    "react-scripts": {
      "typescript": "^5"
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
