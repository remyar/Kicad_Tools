{
    "name": "kicadtools",
    "version": "0.10.0",
    "description": "A lot of tools for Kicad",
    "main": "./main.js",
    "scripts": {
        "start": "craco start",
        "build": "craco build",
        "dist": "electron-builder"
    },
    "author": "ARNAUDIN Rémy",
    "build": {
        "asar": true,
        "directories": {
            "output": "out"
        },
        "publish": [
            {
                "owner": "WesterosCraftCode",
                "repo": "ElectronLauncher",
                "provider": "github"
            }
        ],
        "extraMetadata": {
            "main": "main.js"
        },
        "win": {
            "icon": "res/icons/kicad_tools.ico",
            "publish": [
                {
                    "provider": "github",
                    "repo": "Kicad_Tools",
                    "owner": "remyar"
                }
            ],
            "artifactName": "${name}-Setup-${version}.${ext}",
            "files": [
                "!out/*",
                "!webpack*",
                "!src/*",
                "!*.log",
                "!node_modules/*",
                "!dev-app-update.yml",
                "!.vscode/*",
                "!.github/*",
                "!*.md",
                "!public/*"
            ]
        }
    },
    "dependencies": {
        "@craco/craco": "^7.1.0",
        "@electron/remote": "^2.1.2",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.0",
        "@mui/icons-material": "^6.3.1",
        "@mui/material": "^6.3.1",
        "@react-three/drei": "^9.120.6",
        "@react-three/fiber": "^8.17.12",
        "@remyar/react-navigation": "^2.0.4",
        "@remyar/react-snackbar": "^1.0.0",
        "@remyar/react-store": "^2.0.7",
        "electron-fetch": "^1.9.1",
        "electron-is-dev": "^3.0.1",
        "electron-log": "^5.2.4",
        "electron-updater": "^6.3.9",
        "fast-xml-parser": "^4.5.1",
        "lodash-es": "^4.17.21",
        "node-html-parser": "^7.0.1",
        "node-sexp": "^1.0.1",
        "node-stream-zip": "^1.15.0",
        "ramda": "^0.30.1",
        "react": "19.0.0",
        "react-dom": "^19.0.0",
        "react-intl": "^7.1.0",
        "react-router-dom": "^7.1.1",
        "react-scripts": "^5.0.1",
        "s-expression": "^3.1.1",
        "svg-parser": "^2.0.4",
        "three": "^0.172.0"
    },
    "proxy": "http://localhost:4000",
    "homepage": ".",
    "devDependencies": {
        "electron": "^33.3.1",
        "electron-builder": "^25.1.8"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    }
}
