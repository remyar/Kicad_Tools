{
    "name": "kicadtools",
    "version": "0.8.12",
    "description": "A lot of tools for Kicad",
    "main": "./main.js",
    "scripts": {
        "start": "craco start",
        "build": "craco build",
        "dist": "electron-builder"
    },
    "author": "ARNAUDIN Rémy",
    "build": {
        "asar": true,
        "directories": {
            "output": "out"
        },
        "publish": [
            {
                "owner": "WesterosCraftCode",
                "repo": "ElectronLauncher",
                "provider": "github"
            }
        ],
        "extraMetadata": {
            "main": "main.js"
        },
        "win": {
            "icon": "res/icons/kicad_tools.ico",
            "publish": [
                {
                    "provider": "github",
                    "repo": "Kicad_Tools",
                    "owner": "remyar"
                }
            ],
            "artifactName": "${name}-Setup-${version}.${ext}",
            "files": [
                "!out/*",
                "!webpack*",
                "!src/*",
                "!*.log",
                "!node_modules/*",
                "!dev-app-update.yml",
                "!.vscode/*",
                "!.github/*",
                "!*.md",
                "!public/*"
            ]
        }
    },
    "dependencies": {
        "@craco/craco": "^7.1.0",
        "@electron/remote": "^2.1.2",
        "@emotion/react": "^11.11.4",
        "@emotion/styled": "^11.11.5",
        "@mui/icons-material": "^5.15.17",
        "@mui/material": "^5.15.17",
        "electron-fetch": "^1.9.1",
        "electron-log": "^5.1.4",
        "electron-updater": "^6.1.8",
        "fast-xml-parser": "^4.3.6",
        "lodash": "^4.17.21",
        "node-html-parser": "^6.1.13",
        "node-sexp": "^1.0.1",
        "node-stream-zip": "^1.15.0",
        "react": "18.3.1",
        "react-dom": "^18.3.1",
        "react-intl": "^6.6.6",
        "react-router-dom": "^6.23.1",
        "react-scripts": "^5.0.1",
        "s-expression": "^3.1.1"
    },
    "proxy": "http://localhost:4000",
    "homepage": ".",
    "devDependencies": {
        "electron": "^30.0.4",
        "electron-builder": "^24.13.3"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    }
}
